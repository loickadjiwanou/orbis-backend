# ================================================================
# Orbis Backend — Variables d'environnement
# Copier ce fichier en .env et ajuster les valeurs
# ================================================================

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=orbis

# MQTT Broker (EMQX)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=8883
MQTT_USERNAME=backend
MQTT_PASSWORD=change_me_in_production
MQTT_USE_TLS=true
MQTT_CA_CERT=/etc/orbis/certs/ca.crt

# EMQX Admin API
EMQX_API_URL=http://localhost:18083
EMQX_API_KEY=change_me_in_production
EMQX_API_KEY=           # Secret Key généré par EMQX (ex: mzZ8k...)

# Secret partagé pour le premier onboarding des agents
MQTT_REGISTER_SECRET=change_me_in_production

# JWT (générer avec : python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change_me_in_production_use_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — origines autorisées (séparées par des virgules dans le code)
# CORS_ORIGINS=http://localhost:5173

# Rétention des logs (jours)
LOG_RETENTION_DAYS=90

# Compte administrateur créé au premier démarrage
ADMIN_EMAIL=admin@orbis.local
ADMIN_PASSWORD=change_me_in_production
ADMIN_FULL_NAME=Administrator

# ── SMTP Brevo — alertes email ────────────────────────────────────────────────
# Brevo → SMTP & API → SMTP Keys : copier "Login" dans SMTP_USERNAME et "SMTP Key" dans SMTP_PASSWORD
SMTP_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=change_me_in_production
SMTP_PASSWORD=change_me_in_production
SMTP_FROM_EMAIL=noreply@orbis-platform.io
SMTP_FROM_NAME=Orbis Platform
